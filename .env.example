# Copy to .env.local. Local values come from `npx supabase start`;
# production values come from the Supabase dashboard (Project Settings > API keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (never prefix with NEXT_PUBLIC_). Not needed yet.
# SUPABASE_SECRET_KEY=sb_secret_...

# Google sign-in for local Supabase (optional; local dev uses email codes)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email sign-in (6-digit code via Mailpit): local development only. Production is Google-only and ignores this.
EMAIL_LOGIN=on

# Roma's Google account for reading team calendars and sheets, read-only (server-only, never NEXT_PUBLIC_).
# One refresh token covers both scopes; re-run the script below if it predates Sheets.
# Set by: node scripts/connect-google-calendar.mjs <desktop-oauth-client.json> [--vercel]
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# GOOGLE_CALENDAR_ACCOUNT=roma....@gmail.com
