# Copy to .env.local. Local values come from `npx supabase start`;
# production values come from the Supabase dashboard (Project Settings > API keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (never prefix with NEXT_PUBLIC_). Not needed yet.
# SUPABASE_SECRET_KEY=sb_secret_...

# Google sign-in for local Supabase (optional; local dev uses email codes)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email sign-in (6-digit code / link). Needs custom SMTP on hosted Supabase; on for local dev.
EMAIL_LOGIN=on

# Google service account for reading team calendars (server-only, never NEXT_PUBLIC_).
# Import with: node scripts/import-service-account.mjs <key.json> [--vercel]
# GOOGLE_SA_EMAIL=roma-calendar@<project>.iam.gserviceaccount.com
# GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
