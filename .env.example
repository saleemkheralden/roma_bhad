# Copy to .env.local. Local values come from `npx supabase start`;
# production values come from the Supabase dashboard (Project Settings > API keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (never prefix with NEXT_PUBLIC_). Not needed yet.
# SUPABASE_SECRET_KEY=sb_secret_...

# Google sign-in for local Supabase (optional; local dev uses email codes)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email sign-in (6-digit code via Mailpit): local development only. Production is Google-only and ignores this.
EMAIL_LOGIN=on

# Roma's Google account for reading team calendars (server-only, never NEXT_PUBLIC_).
# Set by: node scripts/connect-google-calendar.mjs <desktop-oauth-client.json> [--vercel]
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# GOOGLE_CALENDAR_ACCOUNT=roma....@gmail.com

# Web push (Phase 4). Generate with: node --input-type=module -e "import {generateVAPIDKeys} from 'web-push'; console.log(generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=            (server-only)
# VAPID_SUBJECT=mailto:roma.d.standard@gmail.com
# CRON_SECRET=                  (server-only; Vercel sends it to /api/cron/*)
# SUPABASE_SECRET_KEY=          (server-only; notifications + account deletion)
